NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Canonical VibeNest application origin (not the Omni domain).
VIBENEST_APP_URL=https://vibenest-vinhluong071-code.vercel.app

# Primitive.dev — server-side only; never expose as NEXT_PUBLIC_*.
PRIMITIVE_API_KEY=prim_replace_with_server_api_key
PRIMITIVE_FROM_EMAIL=agent@YOUR_MANAGED_DOMAIN.primitive.email
PRIMITIVE_DOMAIN_ID=replace_with_primitive_domain_id
PRIMITIVE_WEBHOOK_SECRET=replace_with_primitive_webhook_signing_secret

# Supabase Send Email Auth Hook signature secret (copy from Supabase Auth > Hooks).
SEND_EMAIL_HOOK_SECRET=v1,whsec_replace_with_secret_from_supabase

# Private agent bridge and Vercel Cron authentication.
VIBENEST_AGENT_API_SECRET=replace_with_a_long_random_secret
CRON_SECRET=replace_with_a_different_long_random_secret

# Supabase server-only credential for the inbound agent mail event queue.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
