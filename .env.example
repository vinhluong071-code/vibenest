NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Primitive.dev — server-side only; never expose as NEXT_PUBLIC_*.
PRIMITIVE_API_KEY=prim_replace_with_server_api_key
PRIMITIVE_FROM_EMAIL=agent@rust-mule.primitive.email
PRIMITIVE_DOMAIN_ID=7df444b0-34dd-42c4-a4b1-e4c5b7664688

# Private agent bridge and Vercel Cron authentication.
VIBENEST_AGENT_API_SECRET=replace_with_a_long_random_secret
CRON_SECRET=replace_with_a_different_long_random_secret

# Supabase server-only credential for the email notification queue worker.
# Never expose this key to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
